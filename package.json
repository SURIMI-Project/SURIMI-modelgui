{
  "name": "surimi-modelgui",
  "private": true,
  "workspaces": [
    "apps/frontend"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm --workspace apps/frontend run dev --",
    "build": "npm --workspace apps/frontend run build --",
    "lint": "npm --workspace apps/frontend run lint --",
    "preview": "npm --workspace apps/frontend run preview --",
    "docker:up": "docker compose -f deployments/compose.yml up --build -d",
    "docker:down": "docker compose -f deployments/compose.yml down",
    "docker:logs": "docker compose -f deployments/compose.yml logs -f web"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.73.0"
  }
}

# Copy to apps/frontend/.env for the Vite development server.
# The Docker image does not use this file.

# API base URL used by the frontend. Defaults to same-origin /api/v1.
# VITE_API_BASE_URL=/api/v1

# Backend target for the Vite /api/v1 proxy. Used only during development.
# VITE_API_PROXY_TARGET=http://127.0.0.1:18082

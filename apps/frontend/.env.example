# Copy to apps/frontend/.env for `npm run dev`. Vite reads it from this folder.
# The Docker image does not use this file (see deployments/.env.example).

# The current frontend reads scenarios and run statuses from the controller over
# gRPC-Web. Its proxy (Envoy) was removed on 2026-11-17, so use canned responses
# until phase 10 moves the frontend onto the backend API. Inlined at build time.
MOCK=true
# gRPC-Web endpoint of the controller (no trailing slash), only for MOCK=false
# with a gRPC-Web endpoint of your own. Unset -> "/api/controller", which nginx
# now answers with 410. Inlined at build time.
# VITE_API_BASE_URL=

# Copy to apps/frontend/.env for `npm run dev`. Vite reads it from this folder.
# The Docker image does not use this file (see deployments/.env.example).

# gRPC-Web endpoint of the controller (no trailing slash). Inlined at build time.
# Unset -> "/api/controller" (same-origin, proxied by nginx in the Docker image).
# For `npm run dev`, point it at the Envoy grpc-proxy
# (`docker compose -f deployments/compose.yml up grpc-proxy`):
VITE_API_BASE_URL=http://localhost:18081
# true -> use canned controller responses instead of calling the controller
# (for when it is down). Inlined at build time. Default: false.
# MOCK=true

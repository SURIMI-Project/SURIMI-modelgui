# Copy to deployments/.env. Read by `docker compose -f deployments/compose.yml`.
# Every setting has a working local default; only set what you change.
# For `npm run dev` the frontend reads apps/frontend/.env instead
# (see apps/frontend/.env.example).

# --- SURIMI controller -----------------------------------------------------------
# Native gRPC endpoint: https://host[:port] or http://host[:port]. Used by the
# backend (CONTROLLER_MODE=grpc) and by the grpc-proxy (Envoy).
CONTROLLER_GRPC_URL=https://project-surimi-surimi-controller.lab.dive.edito.eu
# Backend: fake = built-in stand-in (default, no controller needed);
# grpc = the controller at CONTROLLER_GRPC_URL.
# CONTROLLER_MODE=fake

# --- database (ADR 0014) -----------------------------------------------------------
# Host port of postgres on 127.0.0.1, for the backend or a SQL client on the host.
# POSTGRES_PORT=15432
# Admin of the bundled postgres instance, used only by db-bootstrap.
# Applied only when the database volume is first created; to change them
# later use ALTER ROLE, or `docker compose ... down -v` (deletes the data).
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres-local-only
# Application user: owns the schema, runs migrations, used by the API.
# Created by db-bootstrap if missing; its password is set on every start, so
# changing DB_PASSWORD here takes effect on the next `up`.
# DB_NAME=surimi_modelgui_db
# DB_USER=surimi_modelgui
# DB_PASSWORD=surimi-local-only

# --- backend API -------------------------------------------------------------------
# Host port of the API on 127.0.0.1, for Bruno and debugging (default 18082).
# API_PORT=18082
# json (default) or console
# LOG_FORMAT=json
# LOG_LEVEL=INFO

# --- sign-in (ADR 0004, docs/features/auth-and-users) ------------------------------
# Signs the access tokens; at least 32 characters. Compose has a local-only
# default; every shared environment sets its own.
# JWT_SECRET=
# Origin users open; SSO redirect URIs are <PUBLIC_BASE_URL>/api/v1/auth/sso/<key>/callback.
# PUBLIC_BASE_URL=http://localhost:18080
# Compose default false (plain http on localhost); true behind https.
# COOKIE_SECURE=false
# Days the sign-in history keeps the IP and the user agent; 0 = not stored.
# RETENTION_LOGIN_IP_DAYS=90
# RETENTION_LOGIN_USER_AGENT_DAYS=90
# Session lengths and sign-in limits (ACCESS_TOKEN_MINUTES, SESSION_MAX_AGE_HOURS,
# SSO_SESSION_MAX_AGE_HOURS, LOGIN_MAX_FAILURES, ...) keep their defaults in
# compose; see the feature README to set them elsewhere.

# First admin: created on every start by the migrate job (create-admin --from-env).
# An existing local user with this e-mail or username is made an active admin
# (an SSO-managed one is left alone); the password is set only when the user is
# created. All five or none: a partly set group stops the migrate job.
# ADMIN_EMAIL=admin@example.org
# ADMIN_USERNAME=admin
# ADMIN_FIRST_NAME=
# ADMIN_LAST_NAME=
# ADMIN_PASSWORD=

# --- SSO with the local Keycloak (compose profile "keycloak") -------------------------
# docker compose -f deployments/compose.yml --profile keycloak up --build -d
# Realm "surimi" from deployments/keycloak/surimi-realm.json; test users
# alice / alice-local-only (admin), bob / bob-local-only (member),
# carol / carol-local-only (no access). Admin console http://localhost:18083,
# user admin.
# OIDC_PROVIDERS=keycloak
# KEYCLOAK_PORT=18083
# KEYCLOAK_ADMIN_PASSWORD=admin-local-only
# Another provider <K>: add it to OIDC_PROVIDERS and set OIDC_<K>_ISSUER,
# OIDC_<K>_CLIENT_ID, OIDC_<K>_CLIENT_SECRET, OIDC_<K>_ROLE_CLAIM,
# OIDC_<K>_ADMIN_VALUES, OIDC_<K>_MEMBER_VALUES (for Keycloak the defaults are
# ROLE_CLAIM=groups, surimi-admins, surimi-members; compose passes only the
# OIDC_KEYCLOAK_* ones; add others to the api service). The OIDC_KEYCLOAK_*
# defaults in compose.yml match the local realm.

# --- web (frontend image) ------------------------------------------------------------
# Host port of the web app (default 18080).
# SURIMI_PORT=18080
# true -> build an image that uses canned controller responses instead of
# calling the controller (for when it is down). Build-time. Default: false.
# MOCK=true
# Where nginx proxies /api/controller/ to: a gRPC-Web endpoint (no trailing
# slash). Read at container start. Default: the compose grpc-proxy service.
# CONTROLLER_BASE_URL=http://grpc-proxy:8080
# Where nginx proxies /api/v1/ to. Default: the compose api service.
# API_BASE_URL=http://api:8000

# --- grpc-proxy (Envoy, compose profile "grpc-proxy") ---------------------------------
# Host port Envoy listens on (default 18081).
# GRPC_PROXY_PORT=18081
# Regex for allowed browser origins (default: any).
# CORS_ALLOWED_ORIGINS=http://localhost:5173

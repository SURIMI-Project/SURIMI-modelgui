# Copy to deployments/.env. Read by `docker compose -f deployments/compose.yml`.
# Every setting has a working local default; only set what you change.
# For `npm run dev` the frontend reads apps/frontend/.env instead
# (see apps/frontend/.env.example).

# --- compose project ---------------------------------------------------------------
# Prefix of container, network and volume names (default surimi-modelgui, the
# `name:` in compose.yml, which this overrides). Another name starts a separate
# stack with its own, empty database volume; the old one is kept, not moved.
# COMPOSE_PROJECT_NAME=surimi-modelgui

# --- ports ---------------------------------------------------------------------------
# Host ports. The web app listens on every interface; the others on 127.0.0.1 only.
# Web app, nginx (default 18080).
# SURIMI_PORT=18080
# Backend API, for Bruno and debugging (default 18082).
# API_PORT=18082
# PostgreSQL, for the backend or a SQL client on the host (default 15432).
# POSTGRES_PORT=15432
# Keycloak, profile "keycloak" (default 18083).
# KEYCLOAK_PORT=18083
# Envoy gRPC-Web proxy, profile "grpc-proxy" (default 18081).
# GRPC_PROXY_PORT=18081
# Profile "observability": Prometheus, Grafana, Jaeger UI (defaults 18090, 18091, 18092).
# PROMETHEUS_PORT=18090
# GRAFANA_PORT=18091
# JAEGER_PORT=18092
# Worker's /metrics, inside the compose network only, not published (default 9102).
# WORKER_METRICS_PORT=9102

# --- SURIMI controller -----------------------------------------------------------
# Native gRPC endpoint: https://host[:port] or http://host[:port]. Used by the
# backend (CONTROLLER_MODE=grpc) and by the grpc-proxy (Envoy).
CONTROLLER_GRPC_URL=https://project-surimi-surimi-controller.lab.dive.edito.eu
# Backend: fake = built-in stand-in (default, no controller needed);
# grpc = the controller at CONTROLLER_GRPC_URL.
# CONTROLLER_MODE=fake

# --- database (ADR 0014) -----------------------------------------------------------
# Admin of the bundled postgres instance, used only by db-bootstrap.
# Applied only when the database volume is first created; to change them
# later use ALTER ROLE, or `docker compose ... down -v` (deletes the data).
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres-local-only
# Application user: owns the schema, runs migrations, used by the API.
# Created by db-bootstrap if missing; its password is set on every start, so
# changing DB_PASSWORD here takes effect on the next `up`.
# DB_NAME=surimi_modelgui_db
# DB_USER=surimi_modelgui
# DB_PASSWORD=surimi-local-only

# --- backend API -------------------------------------------------------------------
# API processes `surimi-backend serve` starts (uvicorn workers), 1 to 32 (default 1).
# One async process handles many connections; more processes help CPU-bound work
# (charts and maps). Each opens up to DB_POOL_SIZE + 10 database connections
# (default 20): keep WEB_CONCURRENCY x 20 under PostgreSQL's max_connections (100).
# WEB_CONCURRENCY=1
# json (default) or console
# LOG_FORMAT=json
# LOG_LEVEL=INFO
# Largest species CSV an admin may import, in MB (default 10). nginx allows
# 10 MB for that path (deployments/nginx/default.conf.template): raise both.
# CATALOG_IMPORT_MAX_MB=10

# --- sign-in (ADR 0004, docs/features/auth-and-users) ------------------------------
# Signs the access tokens; at least 32 characters. Compose has a local-only
# default; every shared environment sets its own.
# JWT_SECRET=
# Origin users open; SSO redirect URIs are <PUBLIC_BASE_URL>/api/v1/auth/sso/<key>/callback.
# An SSO sign-in started on another host name is sent here first.
# PUBLIC_BASE_URL=http://localhost:18080
# Compose default false (plain http on localhost); true behind https.
# COOKIE_SECURE=false
# Sign-in and home page at <PUBLIC_BASE_URL>/api/v1/console/ (docs/features/backend-console).
# CONSOLE_ENABLED=true
# Session lengths and sign-in limits (ACCESS_TOKEN_MINUTES, SESSION_MAX_AGE_HOURS,
# SSO_SESSION_MAX_AGE_HOURS, LOGIN_MAX_FAILURES, ...) keep their defaults in
# compose; see the feature README to set them elsewhere.

# First admin: created on every start by the migrate job (create-admin --from-env).
# An existing local user with this e-mail or username is made an active admin
# (an SSO-managed one is left alone); the password is set only when the user is
# created. All five or none: a partly set group stops the migrate job.
# ADMIN_EMAIL=admin@example.org
# ADMIN_USERNAME=admin
# ADMIN_FIRST_NAME=
# ADMIN_LAST_NAME=
# ADMIN_PASSWORD=

# --- SSO (ADR 0004; local Keycloak: compose profile "keycloak") -------------------------
# Local Keycloak: docker compose -f deployments/compose.yml --profile keycloak up --build -d
# Realm "surimi" from deployments/mounts/keycloak/surimi-realm.json; test users
# alice / alice-local-only (admin), bob / bob-local-only (member),
# carol / carol-local-only (no access). Admin console http://localhost:18083,
# user admin. The OIDC_KEYCLOAK_* defaults in compose.yml match this realm.
# OIDC_PROVIDERS=keycloak
# KEYCLOAK_ADMIN_PASSWORD=admin-local-only
# An external Keycloak: its realm URL as issuer (…/realms/<realm>, not the admin
# console), the client's id and secret, and the groups that mean admin and member
# (Group Membership mapper, claim "groups", added to the ID token):
# OIDC_KEYCLOAK_ISSUER=https://<host>/realms/<realm>
# Only when the API reaches the provider at another address than browsers do:
# OIDC_KEYCLOAK_DISCOVERY_URL=
# OIDC_KEYCLOAK_CLIENT_ID=surimi-modelgui
# OIDC_KEYCLOAK_CLIENT_SECRET=
# OIDC_KEYCLOAK_DISPLAY_NAME=Keycloak
# OIDC_KEYCLOAK_ROLE_CLAIM=groups
# OIDC_KEYCLOAK_ADMIN_VALUES=surimi-admins
# OIDC_KEYCLOAK_MEMBER_VALUES=surimi-members
# OIDC_KEYCLOAK_DEFAULT_ROLE=deny
# Another provider <K>: add it to OIDC_PROVIDERS and set the same OIDC_<K>_*
# variables; compose passes only the OIDC_KEYCLOAK_* ones (add others to the api
# service).

# --- web (frontend image) ------------------------------------------------------------
# true -> build an image that uses canned controller responses instead of
# calling the controller (for when it is down). Build-time. Default: false.
# MOCK=true
# Where nginx proxies /api/controller/ to: a gRPC-Web endpoint (no trailing
# slash). Read at container start. Default: the compose grpc-proxy service.
# CONTROLLER_BASE_URL=http://grpc-proxy:8080
# Where nginx proxies /api/v1/ to. Default: the compose api service.
# API_BASE_URL=http://api:8000

# --- grpc-proxy (Envoy, compose profile "grpc-proxy") ---------------------------------
# Regex for allowed browser origins (default: any).
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- experiment queue and worker (ADR 0015, ADR 0019) --------------------------------
# Must equal the controller's ECOPATH_NR_OF_PODS and NR_OF_MSE_RUNS (project-surimi: 10
# and 5). The queue sends a run only when its pods are free; Error runs keep theirs.
# ECOPATH_PODS=10
# CONTROLLER_MSE_SIMULATIONS=5
# MAX_PODS_PER_USER=5
# MAX_QUEUED_EXPERIMENTS_PER_USER=10
# Timeouts and the rest keep their defaults; see docs/features/experiment-queue.

# --- outputs (ADR 0009, ADR 0020) ------------------------------------------------------
# Where <id>/<id>.nc lives. Local folder (mounted at /data/experiments from
# OUTPUTS_LOCAL_DIR, default ../output_folder/experiments) or the EDITO bucket:
# OUTPUTS_URI=file:///data/experiments
# OUTPUTS_URI=s3://oidc-<user>/output_creator/experiments
# OUTPUTS_LOCAL_DIR=../output_folder/experiments
# S3_ENDPOINT_URL=https://minio.dive.edito.eu
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_SESSION_TOKEN=
# Endpoint browsers reach; download links are signed for it (default S3_ENDPOINT_URL).
# S3_PUBLIC_ENDPOINT=
# How long a presigned download link works, in seconds: 60 to 604800 (7 days, the S3
# maximum). With S3_SESSION_TOKEN a link also ends when those credentials expire.
# PRESIGNED_URL_TTL_SECONDS=3600

# --- metrics and traces (ADR 0010, docs/features/observability-and-activity) ----------
# /metrics on the API port and on WORKER_METRICS_PORT of the worker; nginx does not
# route it. With WEB_CONCURRENCY > 1 the API processes share their numbers through
# files in PROMETHEUS_MULTIPROC_DIR (empty = a temporary folder; emptied at start).
# METRICS_ENABLED=true
# When set (at least 32 characters), /metrics on the API and the worker answers only
# `Authorization: Bearer <token>`; the profile's Prometheus sends it. Set it whenever
# the API port is reachable from outside (python -c "import secrets; print(secrets.token_urlsafe(48))").
# METRICS_TOKEN=
# PROMETHEUS_MULTIPROC_DIR=
# OTLP/HTTP collector base URL; empty = tracing off. The SDK also reads the other
# OTEL_* variables (OTEL_SERVICE_NAME, OTEL_TRACES_SAMPLER, OTEL_TRACES_SAMPLER_ARG).
# With --profile observability, Jaeger receives them:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
# Grafana's admin password (user admin), profile "observability".
# GRAFANA_ADMIN_PASSWORD=admin-local-only

# --- retention of personal data (ADR 0013) ---------------------------------------------
# Days the sign-in history keeps the IP and the user agent; 0 = not stored.
# RETENTION_LOGIN_IP_DAYS=90
# RETENTION_LOGIN_USER_AGENT_DAYS=90
# Purged by the worker leader every RETENTION_PURGE_INTERVAL_HOURS; 0 = keep forever.
# Sign-in rows older than RETENTION_LOGIN_EVENTS_DAYS are rolled up by month, then deleted.
# RETENTION_PURGE_INTERVAL_HOURS=24
# RETENTION_LOGIN_EVENTS_DAYS=395
# RETENTION_AUDIT_DAYS=730
# RETENTION_SESSIONS_DAYS=30
# RETENTION_DELETED_EXPERIMENTS_DAYS=365

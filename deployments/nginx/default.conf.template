# Keep the caller's X-Request-ID (Bruno, scripts); otherwise use nginx's own.
# The API accepts it only if it is 1-64 safe characters and makes its own if not.
map $http_x_request_id $surimi_request_id {
  default $http_x_request_id;
  ""      $request_id;
}

# Keep the scheme a TLS proxy in front of this container saw (the develop
# server's host nginx sends X-Forwarded-Proto https); otherwise ours.
map $http_x_forwarded_proto $surimi_forwarded_proto {
  default $http_x_forwarded_proto;
  ""      $scheme;
}

server {
  listen 80;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  # The browser no longer reaches the controller: the gRPC-Web proxy (Envoy) was
  # removed on 2026-11-17, and only the backend talks to the controller. An old
  # frontend build that still calls here gets a plain 410 instead of the SPA.
  location /api/controller/ {
    return 410;
  }

  # Backend REST API (apps/backend). The upstream goes through a variable so its
  # hostname is resolved per request: nginx still starts when the API is not
  # running. NGINX_LOCAL_RESOLVERS is filled from /etc/resolv.conf by the image
  # entrypoint. The original URI is kept.
  location /api/v1/ {
    resolver ${NGINX_LOCAL_RESOLVERS} valid=30s;
    set $api_upstream ${API_BASE_URL};
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $surimi_forwarded_proto;
    # One id for nginx's and the API's log lines of the same request.
    proxy_set_header X-Request-ID $surimi_request_id;
  }

  # Species CSV import (admin): the only request with a large body. nginx's
  # 1 MB default stays for every other API path; the API caps this one at
  # CATALOG_IMPORT_MAX_MB (10). Keep this size in step with that setting.
  location = /api/v1/admin/species/import {
    client_max_body_size 10m;
    resolver ${NGINX_LOCAL_RESOLVERS} valid=30s;
    set $api_upstream ${API_BASE_URL};
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $surimi_forwarded_proto;
    proxy_set_header X-Request-ID $surimi_request_id;
  }

  # Local outputs mode: the API authorises a download, then hands the file to
  # nginx with X-Accel-Redirect (ADR 0009). `internal`: not reachable directly.
  location /protected-outputs/ {
    internal;
    alias /data/experiments/;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}

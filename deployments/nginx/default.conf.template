# Keep the caller's X-Request-ID (Bruno, scripts); otherwise use nginx's own.
# The API accepts it only if it is 1-64 safe characters and makes its own if not.
map $http_x_request_id $surimi_request_id {
  default $http_x_request_id;
  ""      $request_id;
}

server {
  listen 80;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  # Retain the same-origin backend REST proxy for the later frontend integration.
  # Resolve per request so nginx starts without a running API.
  location /api/v1/ {
    resolver ${NGINX_LOCAL_RESOLVERS} valid=30s;
    set $api_upstream ${API_BASE_URL};
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # One id for nginx's and the API's log lines of the same request.
    proxy_set_header X-Request-ID $surimi_request_id;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}

# Keep the caller's X-Request-ID (Bruno, scripts); otherwise use nginx's own.
# The API accepts it only if it is 1-64 safe characters and makes its own if not.
map $http_x_request_id $surimi_request_id {
  default $http_x_request_id;
  ""      $request_id;
}

server {
  listen 80;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  # Proxy to the SURIMI controller's gRPC-Web endpoint (normally the Envoy
  # grpc-proxy). gRPC-Web is plain HTTP/1.1, so this is proxy_pass, not grpc_pass.
  # The upstream goes through a variable so its hostname is resolved per request:
  # nginx still starts when the upstream is down or not deployed.
  # NGINX_LOCAL_RESOLVERS is filled from /etc/resolv.conf by the image entrypoint.
  location /api/controller/ {
    resolver ${NGINX_LOCAL_RESOLVERS} valid=30s;
    set $controller_upstream ${CONTROLLER_BASE_URL};
    # /api/controller/pkg.Service/Method -> {base}/pkg.Service/Method
    rewrite ^/api/controller/(.*)$ /$1 break;
    proxy_pass $controller_upstream;
    proxy_http_version 1.1;
    # gRPC-Web responses may stream; pass them through as they arrive.
    proxy_buffering off;
    # Send SNI for HTTPS upstreams; Host defaults to the upstream's host.
    proxy_ssl_server_name on;
  }

  # Backend REST API (apps/backend). Same per-request resolution as above, so
  # nginx starts even when the API is not running. The original URI is kept.
  location /api/v1/ {
    resolver ${NGINX_LOCAL_RESOLVERS} valid=30s;
    set $api_upstream ${API_BASE_URL};
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # One id for nginx's and the API's log lines of the same request.
    proxy_set_header X-Request-ID $surimi_request_id;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}

# --- Frontend (Vite) --------------------------------------------------------
# gRPC-Web endpoint of the controller (no trailing slash). Inlined at build time.
# Unset -> "/api/controller" (same-origin, proxied by nginx in the Docker image).
# For `npm run dev`, point it at the Envoy grpc-proxy:
VITE_API_BASE_URL=http://localhost:18081

# --- grpc-proxy (Envoy, compose profile "grpc-proxy") -------------------------
# Native gRPC endpoint of the controller: https://host[:port] or http://host[:port].
CONTROLLER_GRPC_URL=https://user-rikkert-surimi-controller.lab.dive.edito.eu
# Host port Envoy listens on (default 18081).
# GRPC_PROXY_PORT=18081
# Regex for allowed browser origins (default: any).
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- web (nginx) --------------------------------------------------------------
# Where nginx proxies /api/controller/ to: a gRPC-Web endpoint (no trailing
# slash). Read at container start. Default: the compose grpc-proxy service.
# CONTROLLER_BASE_URL=http://grpc-proxy:8080
